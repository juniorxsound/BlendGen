FROM ubuntu:24.04

LABEL org.opencontainers.image.title="BlendGen CPU"
LABEL org.opencontainers.image.description="Synthetic data generation with Blender"
LABEL org.opencontainers.image.authors="Or Fleisher <contact@orfleisher.com>"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HW=CPU

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        blender \
        ca-certificates \
        libegl1 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
COPY docker/blendgen.pth /usr/local/lib/python3.12/dist-packages/blendgen.pth

# Ubuntu's Blender includes /usr/local/lib/python3.12/dist-packages in its
# isolated Python path. The .pth file above also makes the mounted source tree
# importable when Blender executes a script from /data.
RUN python3 -m pip install \
        --break-system-packages \
        --no-cache-dir \
        -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

WORKDIR /data

CMD ["blender", "--version"]
