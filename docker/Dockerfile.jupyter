FROM python:3.12-slim

LABEL org.opencontainers.image.title="BlendGen Jupyter"
LABEL org.opencontainers.image.description="Native-architecture notebook environment for BlendGen"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt

RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

WORKDIR /data

CMD ["jupyter", "notebook", "--ip", "0.0.0.0", "--port", "8083", "--allow-root"]
